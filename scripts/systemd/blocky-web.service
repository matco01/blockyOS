[Unit]
Description=blockyOS web app (UI + API)
After=network.target blocky-llm.service

[Service]
User=blocky
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib
EnvironmentFile=-/etc/blocky/blocky.env
WorkingDirectory=/opt/blocky/app/backend
ExecStart=/opt/blocky/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
